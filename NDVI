// ======================================================
// NDVI SENTINEL-2 TAHUN 2017
// TEMPORAL CLOUD GAP FILLING
// ======================================================

// 1. REGION PENELITIAN

Map.centerObject(region, 12);


// 2. PERIODE UTAMA

var startDate = '2017-03-01';
var endDate   = '2017-10-01';


// 3. SENTINEL-2 SURFACE REFLECTANCE HARMONIZED
// Dataset ini memiliki band SCL

var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterBounds(region)
  .filterDate(startDate, endDate);

print('Jumlah citra awal:', s2.size());


// 4. MASKING AWAN MENGGUNAKAN SCL

function maskS2(img) {

  var scl = img.select('SCL');

  var mask = scl.neq(0)    // No data
    .and(scl.neq(1))       // Saturated / defective
    .and(scl.neq(3))       // Cloud shadow
    .and(scl.neq(8))       // Medium probability cloud
    .and(scl.neq(9))       // High probability cloud
    .and(scl.neq(10))      // Cirrus
    .and(scl.neq(11));     // Snow / ice

  return img.updateMask(mask)
    .copyProperties(img, ['system:time_start']);
}


// 5. MASKING CITRA PERIODE UTAMA

var s2Main = s2
  .filter(ee.Filter.lte('CLOUDY_PIXEL_PERCENTAGE', 80))
  .map(maskS2);

print('Jumlah citra utama:', s2Main.size());


// 6. KOMPOSIT UTAMA

var compositeMain = s2Main.median();


// 7. FALLBACK SELURUH TAHUN 2017
// Menggunakan dataset yang sama dengan komposit utama

var s2Fallback = ee.ImageCollection(
    'COPERNICUS/S2_SR_HARMONIZED'
  )
  .filterBounds(region)
  .filterDate('2017-01-01', '2018-01-01')
  .filter(ee.Filter.lte('CLOUDY_PIXEL_PERCENTAGE', 100))
  .map(maskS2);

print('Jumlah citra fallback:', s2Fallback.size());


// 8. KOMPOSIT FALLBACK

var compositeFallback = s2Fallback.median();


// 9. TEMPORAL CLOUD GAP FILLING

var imgFilled = compositeMain.unmask(
  compositeFallback, false
);


// 10. HITUNG NDVI

var ndvi = imgFilled
  .normalizedDifference(['B8', 'B4'])
  .rename('NDVI')
  .clip(region);


// 11. VISUALISASI NDVI

Map.addLayer(
  ndvi,
  {
    min: -1,
    max: 1,
    palette: ['blue', 'white', 'green']
  },
  'NDVI 2017 Cloud-Free'
);


// 12. VISUALISASI RGB

Map.addLayer(
  imgFilled,
  {
    bands: ['B4', 'B3', 'B2'],
    min: 0,
    max: 3000
  },
  'RGB Composite 2017',
  false
);


// 13. CEK HASIL

print('Komposit utama:', compositeMain);
print('Komposit fallback:', compositeFallback);
print('Hasil gap filling:', imgFilled);
print('NDVI 2017:', ndvi);


// 14. EXPORT NDVI

Export.image.toDrive({
  image: ndvi,
  description: 'NDVI_2017_CloudFree',
  folder: 'GEE_Export',
  fileNamePrefix: 'NDVI_2017_CloudFree',
  region: region,
  scale: 10,
  maxPixels: 1e13
});


// 15. EXPORT CITRA KOMPOSIT

Export.image.toDrive({
  image: imgFilled.select(['B2', 'B3', 'B4', 'B8']),
  description: 'S2_Composite_2017_CloudFree',
  folder: 'GEE_Export',
  fileNamePrefix: 'S2_Composite_2017_CloudFree',
  region: region,
  scale: 10,
  maxPixels: 1e13
});
